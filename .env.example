# ============================================================
# HEALTHCARE BLOCKCHAIN — ENVIRONMENT VARIABLES (EXAMPLE)
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# --- Backend ---
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/healthcare_blockchain

# JWT
JWT_SECRET=replace_with_long_random_secret_min_64_chars
JWT_EXPIRES_IN=8h

# AES-256-GCM encryption key for medical records (hex, 32 bytes = 64 hex chars)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RECORD_ENCRYPTION_KEY=replace_with_64_hex_chars

# Off-chain storage root (local dev)
STORAGE_PATH=./storage/records

# Blockchain
HARDHAT_RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=
# Private key of the backend signer account (Hardhat account #0 for dev only)
BACKEND_SIGNER_PRIVATE_KEY=replace_with_hardhat_account_0_private_key

# Hospital wallet addresses (from Hardhat accounts)
HOSPITAL_A_ADDRESS=
HOSPITAL_B_ADDRESS=

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:5000/api
VITE_CHAIN_ID=31337
VITE_CONTRACT_ADDRESS=

# ============================================================
# PRODUCTION NOTES
# - Replace RECORD_ENCRYPTION_KEY with a KMS-managed key
# - Replace local storage with a secure object store (S3 + SSE)
# - Replace Hardhat RPC with a real permissioned network endpoint
# - Rotate JWT_SECRET regularly
# ============================================================
